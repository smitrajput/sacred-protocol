# Arbitrum One (chain 42161). Every address below was checked against the chain on
# 2026-10-04: it has code, and the tokens and feeds report the names shown.
# Copy to .env, fill in the blanks, and never commit the result.
#
# Order: DeployToken first, then Deploy once per bucket with TIMELOCK, FUND and RESERVE
# taken from DeployToken's output, all with the same deployer and before the time-lock
# accepts ownership.
#   forge script script/DeployToken.s.sol --rpc-url $ARBITRUM_RPC_URL --broadcast --verify
#   forge script script/Deploy.s.sol      --rpc-url $ARBITRUM_RPC_URL --broadcast --verify

ARBITRUM_RPC_URL=
PRIVATE_KEY=

# People. MULTISIG must be a contract (a Safe); it alone can use the time-lock.
MULTISIG=
TREASURY=
GUARDIAN=
MANAGER=
DISTRIBUTOR=

# Both scripts
USDC=0xaf88d065e77c8cC2239327C5EDb3A432268e5831            # native USDC, 6 decimals

# ── DeployToken ──
POOL_MANAGER=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32   # Uniswap v4 PoolManager
# Launch fee, in basis points and seconds. These are the script's defaults.
START_BUY_BPS=2000
START_SELL_BPS=3000
FLOOR_BUY_BPS=100
FLOOR_SELL_BPS=300
LAUNCH_DURATION=3600
LAUNCH_HALF_LIFE=600

# ── Deploy (one bucket) ── from DeployToken's output:
TIMELOCK=
FUND=
RESERVE=

ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45          # Uniswap v3 SwapRouter02
SEQUENCER_FEED=0xFdB631F5EE196F0ed6FAa767959853A9F217697D  # Chainlink L2 sequencer uptime
POOL_FEE=500                                               # the 0.05% pools are the deep ones
# The oracle rejects a price older than this. One hour is the strict default; Chainlink
# only promises an update per heartbeat when the price is quiet, so a quiet hour makes
# opens and settlements revert until the next update. Confirm each feed's heartbeat on
# data.chain.link before choosing.
FEED_MAX_AGE=3600
BUCKET_CAP=
FIRST_CUTOFF=
NAME=

# BTC bucket
COIN=0x2f2a2543B76A4166549F7aaB2e75Bef0aefC5B0f            # WBTC, 8 decimals
COIN_DECIMALS=8
FEED=0x6ce185860a4963106506C203335A2910413708e9            # Chainlink BTC / USD
MAX_LEVERAGE_BPS=30000

# ETH bucket (swap these in for the second run)
# COIN=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1          # WETH, 18 decimals
# COIN_DECIMALS=18
# FEED=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612          # Chainlink ETH / USD
# MAX_LEVERAGE_BPS=20000
